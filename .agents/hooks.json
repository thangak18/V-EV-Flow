{
  "schema_version": 1,
  "hooks": [
    {
      "event": "SessionStart",
      "timeout": 5
    },
    {
      "event": "Stop",
      "timeout": 5
    },
    {
      "event": "PreToolUse",
      "timeout": 5,
      "claude_matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit",
      "codex_matcher": "^(Bash|apply_patch|Edit|Write)$"
    }
  ]
}

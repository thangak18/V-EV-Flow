{
  "description": "GENERATED from .agents/hooks.json by harness.py sync",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.github/scripts/harness.py\" hook --provider codex --event SessionStart",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.github/scripts/harness.py\" hook --provider codex --event Stop",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.github/scripts/harness.py\" hook --provider codex --event PreToolUse",
            "timeout": 5
          }
        ],
        "matcher": "^(Bash|apply_patch|Edit|Write)$"
      }
    ]
  }
}

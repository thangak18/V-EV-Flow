# Local configuration: backend Settings reads root .env.
# Vite reads root .env (envDir) or exported VITE_* variables.
# Fake/mock defaults run without real credentials.
GOONG_REST_API_KEY=
# Public frontend map key; restrict origin/domain as supported by Goong.
VITE_GOONG_MAP_KEY=
VITE_API_BASE_URL=http://localhost:8000/api
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATA_BACKEND=mock
PREDICTOR_BACKEND=fake
ROUTE_BACKEND=fake
DATA_DIR=./app/backend/modules/station_data
MODEL_DIR=./app/backend/modules/prediction/artifacts
# DEMO_MODE is a future feature flag; current Settings does not consume it.
DEMO_SEED=42
MIN_ARRIVAL_SOC_PCT=10

# Optional runtime V2. REST credentials stay server-side; default mode is offline/mock.
PLACES_BACKEND=disabled
ALLOCATION_BACKEND=memory
ALLOCATION_DB_PATH=.cache/allocation.sqlite3
# REPLAY_OBSERVED_AT=2026-10-13T16:00:00+07:00
# CAPACITY_MODELS_DIR=/absolute/path/capacity-v2
# Enable real data only after partner schema/source review and feed integration.
# PARTNER_SOURCE=partner-name
# PARTNER_INGEST_TOKEN=generate-a-random-token-outside-git
PARTNER_HISTORY_PATH=.cache/partner-history.sqlite3
LIVE_MAX_AGE_SECONDS=600
